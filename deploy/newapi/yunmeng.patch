diff --git a/model/affiliate.go b/model/affiliate.go
new file mode 100644
index 0000000..0609543
--- /dev/null
+++ b/model/affiliate.go
@@ -0,0 +1,83 @@
+package model
+
+import "gorm.io/gorm"
+
+// AffiliateCommission 代理佣金流水。
+//
+// 为什么必须有这张表:提现核对与代理查明细都要按笔追溯,
+// 只靠 users.aff_quota 一个汇总数字做不到。
+type AffiliateCommission struct {
+	Id         int    `json:"id"`
+	UserId     int    `json:"user_id" gorm:"index:idx_aff_user_status,priority:1"`     // 收佣金的代理
+	FromUserId int    `json:"from_user_id" gorm:"index"`                               // 产生消费的用户
+	ModelName  string `json:"model_name" gorm:"type:varchar(128)"`
+	Level      int    `json:"level"`                                                   // 1=直属,2+=团队奖励
+	Profit     int    `json:"profit"`                                                  // 本次消费的利润(计佣基数)
+	Amount     int    `json:"amount"`                                                  // 佣金额度
+	Status     string `json:"status" gorm:"type:varchar(20);index:idx_aff_user_status,priority:2"`
+	CreatedAt  int64  `json:"created_at" gorm:"autoCreateTime;index"`
+}
+
+const (
+	AffCommissionActive  = "active"  // 正常
+	AffCommissionRevoked = "revoked" // 经核查确认异常,已冲销
+)
+
+// 提现不在本表标记 —— 提现是按金额从余额扣减,与具体是哪几笔佣金无关,
+// 单独记在 affiliate_withdrawals 表里。可提现额就是 users.aff_quota。
+
+// RecordAffiliateCommissions 在一个事务里写入多笔佣金并累加到各自的 aff_quota。
+// 任一笔失败则整体回滚,避免流水与余额对不上。
+func RecordAffiliateCommissions(rows []AffiliateCommission) error {
+	if len(rows) == 0 {
+		return nil
+	}
+	return DB.Transaction(func(tx *gorm.DB) error {
+		if err := tx.Create(&rows).Error; err != nil {
+			return err
+		}
+		for _, r := range rows {
+			if r.Amount <= 0 {
+				continue
+			}
+			err := tx.Model(&User{}).Where("id = ?", r.UserId).Updates(map[string]interface{}{
+				"aff_quota":   gorm.Expr("aff_quota + ?", r.Amount),
+				"aff_history": gorm.Expr("aff_history + ?", r.Amount),
+			}).Error
+			if err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+}
+
+// GetUserAffiliateCommissions 分页查某个代理的佣金明细。
+func GetUserAffiliateCommissions(userId, offset, limit int) (rows []AffiliateCommission, total int64, err error) {
+	q := DB.Model(&AffiliateCommission{}).Where("user_id = ?", userId)
+	if err = q.Count(&total).Error; err != nil {
+		return
+	}
+	err = q.Order("id desc").Offset(offset).Limit(limit).Find(&rows).Error
+	return
+}
+
+// SumAffiliateCommissionByStatus 汇总某状态下的佣金总额,供前端展示"可提现"金额。
+func SumAffiliateCommissionByStatus(userId int, status string) (int, error) {
+	var sum int
+	err := DB.Model(&AffiliateCommission{}).
+		Where("user_id = ? AND status = ?", userId, status).
+		Select("COALESCE(SUM(amount), 0)").Scan(&sum).Error
+	return sum, err
+}
+
+// CountInvitedUsers 实时统计某人推荐了多少用户。
+//
+// 不用 users.aff_count —— 它的累加被上游绑在「注册赠送」分支里
+// (QuotaForInviter > 0 才执行),本站不做赠送,那个字段永远是 0。
+// inviter_id 有索引,实时 COUNT 成本可忽略,而且对历史用户也准。
+func CountInvitedUsers(userId int) (int64, error) {
+	var n int64
+	err := DB.Model(&User{}).Where("inviter_id = ?", userId).Count(&n).Error
+	return n, err
+}
diff --git a/model/affiliate_withdrawal.go b/model/affiliate_withdrawal.go
new file mode 100644
index 0000000..19c72b2
--- /dev/null
+++ b/model/affiliate_withdrawal.go
@@ -0,0 +1,106 @@
+package model
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/logger"
+)
+
+// AffiliateWithdrawal 佣金支出流水,两种形式共用一张表:
+//
+//	cash   人工提现 —— 代理加微信,主理人转账后在后台登记
+//	credit 自助转额度 —— 代理自己在钱包页把佣金转成可用额度
+//
+// 合表而不是各建一张:两者本质都是"佣金流出、aff_quota 减少",
+// 只是去向不同。合在一起管理员一眼能看全某个代理取走了多少。
+//
+// 不与 AffiliateCommission 合表 —— 那张每行表示"赚了多少",
+// 这张表示"取走多少",语义不同,混在一起对账会绕。
+type AffiliateWithdrawal struct {
+	Id         int    `json:"id"`
+	UserId     int    `json:"user_id" gorm:"index:idx_aff_wd_user_type,priority:1"`
+	Type       string `json:"type" gorm:"type:varchar(16);default:'cash';index:idx_aff_wd_user_type,priority:2"`
+	Amount     int    `json:"amount"`
+	OperatorId int    `json:"operator_id"`                   // 经办管理员;自助转额度为 0
+	Note       string `json:"note" gorm:"type:varchar(255)"` // 提现必填;自助转额度自动生成
+	CreatedAt  int64  `json:"created_at" gorm:"autoCreateTime;index"`
+}
+
+const (
+	AffOutflowCash   = "cash"   // 人工提现
+	AffOutflowCredit = "credit" // 自助转成消费额度
+)
+
+// RecordAffiliateWithdrawal 登记一笔提现。
+//
+// 整个过程在一个事务里,并对用户行加锁 —— 否则并发登记两笔会双花:
+// 两个请求都读到同样的余额,各自判断"够",然后各扣各的。
+func RecordAffiliateWithdrawal(userId, amount, operatorId int, note string) error {
+	if amount <= 0 {
+		return errors.New("提现金额必须大于 0")
+	}
+	if note == "" {
+		return errors.New("请填写备注")
+	}
+
+	tx := DB.Begin()
+	if tx.Error != nil {
+		return tx.Error
+	}
+	defer tx.Rollback()
+
+	var user User
+	if err := lockForUpdate(tx).First(&user, userId).Error; err != nil {
+		return err
+	}
+	if user.AffQuota < amount {
+		return fmt.Errorf("佣金余额不足,当前可提 %s", logger.LogQuota(user.AffQuota))
+	}
+
+	user.AffQuota -= amount
+	if err := tx.Save(&user).Error; err != nil {
+		return err
+	}
+	if err := tx.Create(&AffiliateWithdrawal{
+		UserId:     userId,
+		Type:       AffOutflowCash,
+		Amount:     amount,
+		OperatorId: operatorId,
+		Note:       note,
+	}).Error; err != nil {
+		return err
+	}
+	if err := tx.Commit().Error; err != nil {
+		return err
+	}
+
+	common.SysLog(fmt.Sprintf("佣金提现登记 user_id=%d amount=%d operator_id=%d note=%q",
+		userId, amount, operatorId, note))
+	RecordLog(userId, LogTypeSystem, fmt.Sprintf("佣金提现 %s(经办人 %d)",
+		logger.LogQuota(amount), operatorId))
+	return nil
+}
+
+// SumAffiliateOutflow 某代理按形式汇总的佣金流出额。
+func SumAffiliateOutflow(userId int, outflowType string) (int, error) {
+	var sum int
+	err := DB.Model(&AffiliateWithdrawal{}).
+		Where("user_id = ? AND type = ?", userId, outflowType).
+		Select("COALESCE(SUM(amount), 0)").Scan(&sum).Error
+	return sum, err
+}
+
+// GetUserAffiliateWithdrawals 分页查佣金支出流水。outflowType 为空则不限形式。
+func GetUserAffiliateWithdrawals(userId, offset, limit int, outflowType string) (rows []AffiliateWithdrawal, total int64, err error) {
+	q := DB.Model(&AffiliateWithdrawal{}).Where("user_id = ?", userId)
+	if outflowType != "" {
+		q = q.Where("type = ?", outflowType)
+	}
+	if err = q.Count(&total).Error; err != nil {
+		return
+	}
+	err = q.Order("id desc").Offset(offset).Limit(limit).Find(&rows).Error
+	return
+}
