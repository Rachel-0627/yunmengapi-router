diff --git a/model/affiliate.go b/model/affiliate.go
new file mode 100644
index 0000000..091dbd7
--- /dev/null
+++ b/model/affiliate.go
@@ -0,0 +1,88 @@
+package model
+
+import (
+	"time"
+
+	"gorm.io/gorm"
+)
+
+// AffiliateCommission 代理佣金流水。
+//
+// 为什么必须有这张表:核查期判定、提现审核、代理查明细,三件事都要按笔追溯,
+// 只靠 users.aff_quota 一个汇总数字做不到。
+type AffiliateCommission struct {
+	Id         int    `json:"id"`
+	UserId     int    `json:"user_id" gorm:"index:idx_aff_user_status,priority:1"`     // 收佣金的代理
+	FromUserId int    `json:"from_user_id" gorm:"index"`                               // 产生消费的用户
+	ModelName  string `json:"model_name" gorm:"type:varchar(128)"`
+	Level      int    `json:"level"`                                                   // 1=直属,2+=团队奖励
+	Profit     int    `json:"profit"`                                                  // 本次消费的利润(计佣基数)
+	Amount     int    `json:"amount"`                                                  // 佣金额度
+	Status     string `json:"status" gorm:"type:varchar(20);index:idx_aff_user_status,priority:2"`
+	CreatedAt  int64  `json:"created_at" gorm:"autoCreateTime;index"`
+}
+
+const (
+	AffCommissionActive    = "active"    // 正常。是否可提现按 created_at 与核查期实时判断
+	AffCommissionRevoked   = "revoked"   // 经核查确认异常,已冲销
+	AffCommissionWithdrawn = "withdrawn" // 已人工提现
+)
+
+// RecordAffiliateCommissions 在一个事务里写入多笔佣金并累加到各自的 aff_quota。
+// 任一笔失败则整体回滚,避免流水与余额对不上。
+func RecordAffiliateCommissions(rows []AffiliateCommission) error {
+	if len(rows) == 0 {
+		return nil
+	}
+	return DB.Transaction(func(tx *gorm.DB) error {
+		if err := tx.Create(&rows).Error; err != nil {
+			return err
+		}
+		for _, r := range rows {
+			if r.Amount <= 0 {
+				continue
+			}
+			err := tx.Model(&User{}).Where("id = ?", r.UserId).Updates(map[string]interface{}{
+				"aff_quota":   gorm.Expr("aff_quota + ?", r.Amount),
+				"aff_history": gorm.Expr("aff_history + ?", r.Amount),
+			}).Error
+			if err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+}
+
+// SumWithdrawableCommission 汇总可提现佣金。
+//
+// 不用定时任务把 pending 刷成 available —— 核查期是否已过,查询时按
+// created_at 现算即可,少一套 cron 就少一处会出错的地方。
+func SumWithdrawableCommission(userId, holdHours int) (int, error) {
+	cutoff := time.Now().Add(-time.Duration(holdHours) * time.Hour).Unix()
+	var sum int
+	err := DB.Model(&AffiliateCommission{}).
+		Where("user_id = ? AND status = ? AND created_at <= ?",
+			userId, AffCommissionActive, cutoff).
+		Select("COALESCE(SUM(amount), 0)").Scan(&sum).Error
+	return sum, err
+}
+
+// GetUserAffiliateCommissions 分页查某个代理的佣金明细。
+func GetUserAffiliateCommissions(userId, offset, limit int) (rows []AffiliateCommission, total int64, err error) {
+	q := DB.Model(&AffiliateCommission{}).Where("user_id = ?", userId)
+	if err = q.Count(&total).Error; err != nil {
+		return
+	}
+	err = q.Order("id desc").Offset(offset).Limit(limit).Find(&rows).Error
+	return
+}
+
+// SumAffiliateCommissionByStatus 汇总某状态下的佣金总额,供前端展示"可提现"金额。
+func SumAffiliateCommissionByStatus(userId int, status string) (int, error) {
+	var sum int
+	err := DB.Model(&AffiliateCommission{}).
+		Where("user_id = ? AND status = ?", userId, status).
+		Select("COALESCE(SUM(amount), 0)").Scan(&sum).Error
+	return sum, err
+}
