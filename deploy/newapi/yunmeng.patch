+package operation_setting
+
+import "github.com/QuantumNous/new-api/setting/config"
+
+// AffiliateSetting 代理佣金配置。规则见 docs/代理佣金规则.md。
+//
+// 佣金基数是「利润」而非消费额 —— 按消费额计佣会让低毛利模型倒亏
+// (如 gpt-image2-4k 毛利仅 28%)。因 new-api 只知售价不知进货价,
+// 这里用一张毛利率表换算,只需列出偏离默认值的例外。
+type AffiliateSetting struct {
+	Enabled bool `json:"enabled"`
+
+	// 直属代理:按被推荐人的绑定时长分档
+	NewUserRate  float64 `json:"new_user_rate"`  // 绑定后 NewUserHours 小时内的比例
+	NewUserHours int     `json:"new_user_hours"` // 新用户奖励窗口
+	LongTermRate float64 `json:"long_term_rate"` // 窗口结束后至 ValidDays 的比例
+	ValidDays    int     `json:"valid_days"`     // 超过则不再产生直属佣金
+
+	// 团队奖励:每级取下一级佣金的 TeamRate,逐级衰减
+	TeamRate float64 `json:"team_rate"`
+	MaxDepth int     `json:"max_depth"` // 向上遍历的硬上限,防成环与过深
+
+	// 模型毛利率。"default" 为兜底值,其余只列例外。设 0 即排除出返佣。
+	MarginRates map[string]float64 `json:"margin_rates"`
+}
+
+var affiliateSetting = AffiliateSetting{
+	Enabled:      false, // 默认关闭,配置齐备并对账后再打开
+	NewUserRate:  0.50,
+	NewUserHours: 7 * 24,
+	LongTermRate: 0.15,
+	ValidDays:    365,
+	TeamRate:     0.05,
+	MaxDepth:     5,
+	MarginRates: map[string]float64{
+		"default":       0.60, // 实测多数模型 60~67%,取下限保守
+		"gpt-image2-4k": 0,    // 毛利仅 28%,返佣会吃穿利润,排除
+	},
+}
+
+func init() {
+	config.GlobalConfig.Register("affiliate_setting", &affiliateSetting)
+}
+
+func GetAffiliateSetting() *AffiliateSetting {
+	return &affiliateSetting
+}
+
+// MarginRateOf 取某模型的毛利率,未单列的走 default。
+func (s *AffiliateSetting) MarginRateOf(modelName string) float64 {
+	if r, ok := s.MarginRates[modelName]; ok {
+		return r
+	}
+	if r, ok := s.MarginRates["default"]; ok {
+		return r
+	}
+	return 0
+}
