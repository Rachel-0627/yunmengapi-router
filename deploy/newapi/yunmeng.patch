diff --git a/service/affiliate.go b/service/affiliate.go
new file mode 100644
index 0000000..a6180d1
--- /dev/null
+++ b/service/affiliate.go
@@ -0,0 +1,107 @@
+package service
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/logger"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/setting/operation_setting"
+)
+
+// DispatchAffiliateCommission 在消费结算后派发代理佣金。
+//
+// 分两段:
+//  1. 直属代理按被推荐人的绑定时长拿利润的一个比例(50% / 15% / 0)
+//  2. 沿 inviter_id 继续向上,每级取下一级佣金的 TeamRate,逐级衰减
+//
+// 额度是整数,衰减到 0 时自然终止,因此团队层级不需要靠深度硬截断;
+// MaxDepth 只作防成环兜底。
+//
+// 任何异常只记日志、不影响主链路 —— 佣金派发失败不该让用户的请求失败。
+func DispatchAffiliateCommission(consumerId int, modelName string, quota int) {
+	defer func() {
+		if r := recover(); r != nil {
+			common.SysLog(fmt.Sprintf("代理佣金派发 panic user_id=%d model=%s: %v", consumerId, modelName, r))
+		}
+	}()
+
+	s := operation_setting.GetAffiliateSetting()
+	if !s.Enabled || quota <= 0 || consumerId <= 0 {
+		return
+	}
+
+	consumer, err := model.GetUserById(consumerId, false)
+	if err != nil || consumer == nil || consumer.InviterId <= 0 {
+		return // 没有上级,平台全留
+	}
+
+	// ── 利润基数 ──
+	margin := s.MarginRateOf(modelName)
+	if margin <= 0 {
+		return // 该模型被排除(如低毛利的 4K 生图)
+	}
+	profit := int(float64(quota) * margin)
+	if profit <= 0 {
+		return
+	}
+
+	// ── 直属佣金:按绑定时长分档 ──
+	// 注册即绑定且不可更换,故 created_at 就是绑定时间。
+	boundFor := time.Since(time.Unix(consumer.CreatedAt, 0))
+	var rate float64
+	switch {
+	case boundFor <= time.Duration(s.NewUserHours)*time.Hour:
+		rate = s.NewUserRate
+	case boundFor <= time.Duration(s.ValidDays)*24*time.Hour:
+		rate = s.LongTermRate
+	default:
+		return // 超过有效期,不再产生佣金
+	}
+
+	amount := int(float64(profit) * rate)
+	if amount <= 0 {
+		return
+	}
+
+	// ── 沿上级链派发 ──
+	rows := make([]model.AffiliateCommission, 0, 4)
+	seen := map[int]bool{consumerId: true}
+	uplineId := consumer.InviterId
+
+	for level := 1; level <= s.MaxDepth && uplineId > 0 && amount > 0; level++ {
+		if seen[uplineId] {
+			common.SysLog(fmt.Sprintf("代理链成环,已截断 user_id=%d upline_id=%d", consumerId, uplineId))
+			break
+		}
+		seen[uplineId] = true
+
+		rows = append(rows, model.AffiliateCommission{
+			UserId:     uplineId,
+			FromUserId: consumerId,
+			ModelName:  modelName,
+			Level:      level,
+			Profit:     profit,
+			Amount:     amount,
+			Status:     model.AffCommissionActive,
+		})
+
+		upline, err := model.GetUserById(uplineId, false)
+		if err != nil || upline == nil || upline.InviterId <= 0 {
+			break
+		}
+		uplineId = upline.InviterId
+		amount = int(float64(amount) * s.TeamRate) // 逐级衰减,归零即停
+	}
+
+	if err := model.RecordAffiliateCommissions(rows); err != nil {
+		common.SysLog(fmt.Sprintf("代理佣金写入失败 user_id=%d: %s", consumerId, err.Error()))
+		return
+	}
+	for _, r := range rows {
+		model.RecordLog(r.UserId, model.LogTypeSystem, fmt.Sprintf(
+			"推广佣金 %s(来自用户 %d 的 %s 消费,第 %d 级)",
+			logger.LogQuota(r.Amount), r.FromUserId, r.ModelName, r.Level))
+	}
+}
