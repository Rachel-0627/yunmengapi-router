@@ -0,0 +1,71 @@
+package controller
+
+import (
+	"strconv"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+
+	"github.com/gin-gonic/gin"
+)
+
+type AffiliateWithdrawRequest struct {
+	UserId int    `json:"user_id"`
+	Amount int    `json:"amount"` // 额度单位,与 aff_quota 一致
+	Note   string `json:"note"`
+}
+
+// AdminWithdrawAffiliate 登记一笔佣金提现(仅管理员)。
+//
+// 系统只记账,不打款 —— 转账由主理人在微信上人工完成。
+// 备注必填:三个月后要能靠它对上是哪一笔微信转账。
+func AdminWithdrawAffiliate(c *gin.Context) {
+	var req AffiliateWithdrawRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		common.ApiErrorMsg(c, "参数错误")
+		return
+	}
+	if req.UserId <= 0 {
+		common.ApiErrorMsg(c, "请选择代理")
+		return
+	}
+	if req.Amount <= 0 {
+		common.ApiErrorMsg(c, "提现金额必须大于 0")
+		return
+	}
+	if req.Note == "" {
+		common.ApiErrorMsg(c, "请填写备注")
+		return
+	}
+
+	operatorId := c.GetInt("id")
+	if err := model.RecordAffiliateWithdrawal(req.UserId, req.Amount, operatorId, req.Note); err != nil {
+		common.ApiError(c, err)
+		return
+	}
+	common.ApiSuccess(c, nil)
+}
+
+// GetAffiliateWithdrawals 查某代理的提现流水(仅管理员)。
+func GetAffiliateWithdrawals(c *gin.Context) {
+	userId, err := strconv.Atoi(c.Param("id"))
+	if err != nil || userId <= 0 {
+		common.ApiErrorMsg(c, "用户 ID 无效")
+		return
+	}
+	page, _ := strconv.Atoi(c.Query("page"))
+	if page < 1 {
+		page = 1
+	}
+	size, _ := strconv.Atoi(c.Query("size"))
+	if size < 1 || size > 100 {
+		size = 20
+	}
+
+	rows, total, err := model.GetUserAffiliateWithdrawals(userId, (page-1)*size, size)
+	if err != nil {
+		common.ApiError(c, err)
+		return
+	}
+	common.ApiSuccess(c, gin.H{"items": rows, "total": total})
+}
