diff --git a/web/src/features/users/components/affiliate-withdraw-dialog.tsx b/web/src/features/users/components/affiliate-withdraw-dialog.tsx
new file mode 100644
index 0000000..7ed0197
--- /dev/null
+++ b/web/src/features/users/components/affiliate-withdraw-dialog.tsx
@@ -0,0 +1,125 @@
+import { useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { toast } from 'sonner'
+
+import { Dialog } from '@/components/dialog'
+import { Button } from '@/components/ui/button'
+import { Input } from '@/components/ui/input'
+import { Label } from '@/components/ui/label'
+import { formatQuota, parseQuotaFromDollars } from '@/lib/format'
+
+import { withdrawAffiliate } from '../api'
+
+interface AffiliateWithdrawDialogProps {
+  open: boolean
+  onOpenChange: (open: boolean) => void
+  userId: number
+  username: string
+  affQuota: number
+  onSuccess: () => void
+}
+
+/**
+ * 登记佣金提现。系统只扣减余额并留流水,打款是主理人在微信上人工完成的。
+ * 备注必填 —— 三个月后要能靠它对上是哪一笔转账。
+ */
+export function AffiliateWithdrawDialog(props: AffiliateWithdrawDialogProps) {
+  const { t } = useTranslation()
+  const [amount, setAmount] = useState('')
+  const [note, setNote] = useState('')
+  const [loading, setLoading] = useState(false)
+
+  const quotaValue = parseQuotaFromDollars(parseFloat(amount) || 0)
+  const overBalance = quotaValue > props.affQuota
+  const canSubmit =
+    quotaValue > 0 && !overBalance && note.trim().length > 0 && !loading
+
+  const handleSubmit = async () => {
+    if (!canSubmit) return
+    setLoading(true)
+    try {
+      const res = await withdrawAffiliate({
+        user_id: props.userId,
+        amount: quotaValue,
+        note: note.trim(),
+      })
+      if (res.success) {
+        toast.success(t('Withdrawal recorded'))
+        setAmount('')
+        setNote('')
+        props.onSuccess()
+        props.onOpenChange(false)
+      } else {
+        toast.error(res.message || t('Failed to record withdrawal'))
+      }
+    } finally {
+      setLoading(false)
+    }
+  }
+
+  return (
+    <Dialog
+      open={props.open}
+      onOpenChange={props.onOpenChange}
+      title={t('Record Commission Withdrawal')}
+      contentClassName='sm:max-w-md'
+    >
+      <div className='space-y-4'>
+        <div className='bg-muted/40 rounded-lg p-3 text-sm'>
+          <div className='flex justify-between'>
+            <span className='text-muted-foreground'>{t('Agent')}</span>
+            <span className='font-medium'>
+              {props.username} (#{props.userId})
+            </span>
+          </div>
+          <div className='mt-1.5 flex justify-between'>
+            <span className='text-muted-foreground'>{t('Withdrawable')}</span>
+            <span className='font-semibold tabular-nums'>
+              {formatQuota(props.affQuota)}
+            </span>
+          </div>
+        </div>
+
+        <div className='space-y-1.5'>
+          <Label htmlFor='aff-amount'>{t('Withdrawal amount')}</Label>
+          <Input
+            id='aff-amount'
+            type='number'
+            value={amount}
+            onChange={(e) => setAmount(e.target.value)}
+            placeholder='0.00'
+          />
+          {overBalance && (
+            <p className='text-destructive text-xs'>
+              {t('Amount exceeds the available commission balance.')}
+            </p>
+          )}
+        </div>
+
+        <div className='space-y-1.5'>
+          <Label htmlFor='aff-note'>
+            {t('Note')} <span className='text-destructive'>*</span>
+          </Label>
+          <Input
+            id='aff-note'
+            value={note}
+            onChange={(e) => setNote(e.target.value)}
+            placeholder={t('e.g. WeChat transfer ref, date')}
+          />
+          <p className='text-muted-foreground text-xs'>
+            {t('Required. Used to match this record against the actual transfer.')}
+          </p>
+        </div>
+
+        <div className='flex justify-end gap-2'>
+          <Button variant='outline' onClick={() => props.onOpenChange(false)}>
+            {t('Cancel')}
+          </Button>
+          <Button onClick={handleSubmit} disabled={!canSubmit}>
+            {t('Confirm')}
+          </Button>
+        </div>
+      </div>
+    </Dialog>
+  )
+}
