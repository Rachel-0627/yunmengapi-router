+		relayInfo.BillingSource != BillingSourceSubscription {
+		userId, modelName := relayInfo.UserId, relayInfo.OriginModelName
+		gopool.Go(func() {
+			DispatchAffiliateCommission(userId, modelName, quota)
+		})
+	}
+
 	return result, nil
 }
 
